# Portibilify API server — environment template.
#
# `npm run env:init` builds `.env` from this file:
#   <generate>   -> replaced with 32 cryptographically random bytes (hex),
#                   created on this machine and never displayed anywhere
#   <paste ...>  -> a value you copy in by hand (the script tells you which)
#   anything else -> a documented default, copied as-is
# Values already present in `.env` are never overwritten; keys that exist in
# `.env` but not here are preserved. See CLAUDE.md "Environment variables".
# Never commit `.env`.

# --- HTTP --------------------------------------------------------------------
PORT=6000
BROWSER_SAFE_PORT=6001
# Extra CORS origins, comma-separated. Localhost origins are always allowed.
CORS_ORIGINS=

# --- Database (Postgres on Aiven) --------------------------------------------
# Aiven console -> project -> PostgreSQL service -> Overview -> "Service URI".
# Keep `sslmode=require` in it: the Prisma CLI (migrations) needs it. The
# runtime Node driver verifies the TLS chain with the CA file below instead.
DATABASE_URL=<paste Aiven Service URI>
# Aiven console -> same Overview page -> "CA certificate" -> Download, saved as
# certs/aiven-ca.pem (certs/ is gitignored). Leave EMPTY for a local Postgres
# without TLS.
DATABASE_SSL_CA_PATH=certs/aiven-ca.pem

# --- Auth (JWT) --------------------------------------------------------------
JWT_ACCESS_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Stage 7 packaging (refinement/packaging) --------------------------------
# HMAC keys for consent-receipt signatures, pseudonymous contributor ids and
# buyer-scoped conversation ids. Losing them invalidates everything minted with
# them: back them up (vault, OD-05) and rotate only with a migration plan.
PSEUDONYM_SECRET=<generate>
CONSENT_SIGNING_SECRET=<generate>
PACKAGING_HMAC_SECRET=<generate>

# --- Stage 6 detector --------------------------------------------------------
# `mock` (default) or `presidio` (docker compose -f docker-compose.presidio.yml up -d).
DETECTOR=mock
# Only read when DETECTOR=presidio.
# PRESIDIO_URL=http://localhost:5002
# PRESIDIO_VERSION=
