generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  buyer
  admin
}

model User {
  contributorAccount ContributorAccount?
  fundAllocations    FundAllocation[]
  id                 String              @id @default(uuid()) @db.Uuid
  name               String?             @db.VarChar(120)
  email              String              @unique @db.VarChar(254)
  passwordHash       String              @map("password_hash")
  role               UserRole            @default(user)
  buyer              Buyer?
  refreshTokens      RefreshToken[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

// ---------------------------------------------------------------------------
// Proof store (spec §5, INV-9). Persists ONLY fingerprints and attestation
// metadata — never prompt content, never matched entity text.
// ---------------------------------------------------------------------------

model RecordFingerprint {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  exactHash      String   @map("exact_hash") @db.VarChar(64)
  simHash        String   @map("sim_hash") @db.VarChar(16)
  rulesetVersion String   @map("ruleset_version") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, exactHash])
  @@index([exactHash])
  @@map("record_fingerprints")
}

model DeidAttestation {
  id                String   @id @default(uuid()) @db.Uuid
  recordFingerprint String   @map("record_fingerprint") @db.VarChar(64)
  payload           Json
  prevHash          String?  @map("prev_hash") @db.VarChar(64)
  chainHash         String   @map("chain_hash") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recordFingerprint])
  @@map("deid_attestations")
}

// ---------------------------------------------------------------------------
// Build #4 — consent receipt (§5.2, FR-5.1, INV-7). ONE per conversation
// (APP-D-08), Kantara / ISO 27560 pattern. The payload is the canonical
// receipt JSON (pseudonymous contributor id + fingerprints — no raw
// identity, no content); the signature binds receipt ↔ fingerprints.
// ---------------------------------------------------------------------------

model ConsentReceipt {
  id         String    @id @default(uuid()) @db.Uuid
  receiptRef String    @unique @map("receipt_ref") @db.VarChar(64)
  userId     String    @map("user_id") @db.Uuid
  payload    Json
  signature  String    @db.VarChar(128)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("consent_receipts")
}

// ---------------------------------------------------------------------------
// Build #2 — Stage 7 packaged record: ONE conversation bundle, de-identified
// prompts in original order (Crossing (2): the de-identified record, the
// consent receipt ref, and provenance are the ONLY things that persist —
// INV-1). chainHash links the bundle into the attestation hash chain
// (FR-5.3). internalConversationRef is internal-only; the buyer-scoped
// conversation_id is derived per buyer at delivery time, never stored here.
// ---------------------------------------------------------------------------

model PackagedRecord {
  id                      String   @id @default(uuid()) @db.Uuid
  recordRef               String   @unique @map("record_ref") @db.VarChar(64)
  userId                  String   @map("user_id") @db.Uuid
  internalConversationRef String   @map("internal_conversation_ref") @db.VarChar(200)
  consentReceiptRef       String   @map("consent_receipt_ref") @db.VarChar(64)
  language                String   @db.VarChar(16)
  capturedWindow          String   @map("captured_window") @db.VarChar(16)
  domainTags              Json     @map("domain_tags")
  prompts                 Json // de-identified prompts, in order (INV-2: prompts-only)
  turnIndexes             Json     @map("turn_indexes")
  status                  String   @default("available") @db.VarChar(16) // available | sold | revoked
  prevHash                String?  @map("prev_hash") @db.VarChar(64)
  chainHash               String   @map("chain_hash") @db.VarChar(64)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, internalConversationRef])
  @@index([status])
  @@map("packaged_records")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Stage 8 — Build #5: buyer briefs (spec §7.4 FR-4.1/4.2, tracker §5).
//
// The FULL brief lives here and never leaves the server (INV-8). The device
// receives only the minimal matching payload (briefRef + categoryId + spec +
// quality); buyer identity, price, volume and escrow state never cross
// (§5.1). A brief is pushed only while `status = live` AND
// `escrowCommitted = true` (D-16). No brief is ever browsable.
// ---------------------------------------------------------------------------

model Buyer {
  userId                  String?  @unique @map("user_id") @db.Uuid
  user                    User?    @relation(fields: [userId], references: [id])
  id                      String   @id @default(uuid()) @db.Uuid
  buyerRef                String   @unique @map("buyer_ref") @db.VarChar(64)
  legalName               String   @map("legal_name") @db.VarChar(200) // internal only — never to the device (INV-6)
  categoryId              String   @map("category_id") @db.VarChar(64) // taxonomy id — the ONE buyer descriptor that leaves the server
  categoryTaxonomyVersion String   @map("category_taxonomy_version") @db.VarChar(16)
  briefs                  Brief[]
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("buyers")
}

model Brief {
  fundingAmountCents     Int?          @map("funding_amount_cents")
  payment                BriefPayment?
  id                     String        @id @default(uuid()) @db.Uuid
  briefRef               String        @unique @map("brief_ref") @db.VarChar(64)
  buyerId                String        @map("buyer_id") @db.Uuid
  buyer                  Buyer         @relation(fields: [buyerId], references: [id])
  status                 String        @default("draft") @db.VarChar(16) // draft | live | paused | filled | expired
  spec                   Json // { domains, languages, keywordsAny, keywordsAll, keywordsNone, minPromptsPerConversation } — pushed to device
  quality                Json // { maxRedactionDensity, dedupGuarantee } — maxRedactionDensity pushed to device
  volume                 Json // { targetConversations, maxPerContributor } — server only
  pricingScheduleVersion String        @map("pricing_schedule_version") @db.VarChar(16) // server only (price never visits the device)
  currency               String        @default("USD") @db.VarChar(3)
  escrowCommitted        Boolean       @default(false) @map("escrow_committed") // D-16 gate for live
  escrowProviderRef      String?       @map("escrow_provider_ref") @db.VarChar(128)
  matches                BriefMatch[]
  expiresAt              DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("briefs")
}

// What the device reports after on-device matching (§5.3): brief + which of
// the contributor's conversations matched, with prompt counts and
// fingerprints. Match METADATA only — never spec-evaluation details, never
// content. Feeds Build #7's QA candidate queue.
model BriefMatch {
  id                      String    @id @default(uuid()) @db.Uuid
  briefId                 String    @map("brief_id") @db.Uuid
  brief                   Brief     @relation(fields: [briefId], references: [id])
  userId                  String    @map("user_id") @db.Uuid
  internalConversationRef String    @map("internal_conversation_ref") @db.VarChar(200)
  promptCount             Int       @map("prompt_count")
  fingerprints            Json // exact SHA-256 hashes of the matched prompts, in turn order
  qaResult                QaResult?
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([briefId, userId, internalConversationRef])
  @@index([userId])
  @@map("brief_matches")
}

// ---------------------------------------------------------------------------
// Stage 8 — Build #7: QA gate result (§7.1.1, FR-3.4 pre-commitment gate).
//
// ONE row per BriefMatch, re-evaluated whenever the conversation is
// re-processed or re-reported, until it is sold. METADATA ONLY: failure
// codes, numbers and versions — never prompt text or the keyword that
// failed (INV-1). A `passed` row carries the precise valuation (Build #6
// §6.3), computed once at QA time on the final de-identified text; these
// rows are the candidates fulfilment selection (§7.2) ranks.
// ---------------------------------------------------------------------------

model QaResult {
  packagedChainHash       String?         @map("packaged_chain_hash")
  allocation              FundAllocation?
  id                      String          @id @default(uuid()) @db.Uuid
  briefMatchId            String          @unique @map("brief_match_id") @db.Uuid
  briefMatch              BriefMatch      @relation(fields: [briefMatchId], references: [id], onDelete: Cascade)
  briefId                 String          @map("brief_id") @db.Uuid
  userId                  String          @map("user_id") @db.Uuid
  internalConversationRef String          @map("internal_conversation_ref") @db.VarChar(200)
  packagedRecordRef       String?         @map("packaged_record_ref") @db.VarChar(64)
  status                  String          @db.VarChar(16) // passed | failed
  failures                Json // QaFailureCode[] — codes only
  language                String          @db.VarChar(16)
  redactionDensity        Float           @map("redaction_density")
  dedupStatus             String          @map("dedup_status") @db.VarChar(24) // new | exact_duplicate | near_duplicate
  tierCounts              Json?           @map("tier_counts") // passed only
  amountCents             Int?            @map("amount_cents") // passed only — NET integer cents (D-33)
  pricingScheduleVersion  String?         @map("pricing_schedule_version") @db.VarChar(16)
  qaVersion               String          @map("qa_version") @db.VarChar(16)
  dedupVersion            String          @map("dedup_version") @db.VarChar(16)
  passedAt                DateTime?       @map("passed_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([briefId, status])
  @@index([userId])
  @@map("qa_results")
}

// Stripe funding ledger. No card details or webhook payloads are stored.
model BriefPayment {
  allocations     FundAllocation[]
  refund          FundRefund?
  ledger          FundLedgerEntry[]
  id              String            @id @default(uuid()) @db.Uuid
  briefId         String            @unique @map("brief_id") @db.Uuid
  brief           Brief             @relation(fields: [briefId], references: [id])
  amountCents     Int               @map("amount_cents")
  currency        String            @default("usd") @db.VarChar(3)
  status          String            @default("pending") @db.VarChar(24)
  attempt         Int               @default(1)
  sessionId       String?           @unique @map("session_id")
  paymentIntentId String?           @unique @map("payment_intent_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("brief_payments")
}

model StripeEvent {
  id        String   @id
  type      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stripe_events")
}

model ContributorAccount {
  user            User     @relation(fields: [userId], references: [id])
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  stripeAccountId String?  @unique @map("stripe_account_id")
  country         String   @db.VarChar(2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contributor_accounts")
}

model FundAllocation {
  activeRecordRef String?      @unique @map("active_record_ref")
  payment         BriefPayment @relation(fields: [paymentId], references: [id])
  qa              QaResult     @relation(fields: [qaId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  qaId            String       @unique @map("qa_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  recordRef       String       @map("record_ref")
  chainHash       String       @map("chain_hash")
  amountCents     Int          @map("amount_cents")
  status          String       @default("reserved") @db.VarChar(24)
  transferId      String?      @unique @map("transfer_id")
  destination     String?
  sourceCharge    String?      @map("source_charge")
  approvedBy      String?      @map("approved_by") @db.Uuid
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([paymentId, status])
  @@index([userId])
  @@map("fund_allocations")
}

model FundRefund {
  payment        BriefPayment @relation(fields: [paymentId], references: [id])
  id             String       @id @default(uuid()) @db.Uuid
  paymentId      String       @unique @map("payment_id") @db.Uuid
  amountCents    Int          @map("amount_cents")
  status         String       @default("pending") @db.VarChar(24)
  stripeRefundId String?      @unique @map("stripe_refund_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("fund_refunds")
}

model FundLedgerEntry {
  payment     BriefPayment @relation(fields: [paymentId], references: [id])
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  eventKey    String       @unique @map("event_key")
  kind        String       @db.VarChar(32)
  amountCents Int          @map("amount_cents")
  reference   String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([paymentId, createdAt])
  @@map("fund_ledger_entries")
}
